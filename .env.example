# =============================================================
# CareerGo environment template.
# Copy this file to `.env` at the project root and fill in real values.
# NEVER commit the real `.env` file to version control.
# =============================================================

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobs_data
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ---- Adzuna API ----
# Register at https://developer.adzuna.com/ to obtain credentials.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ---- DeepSeek / OpenAI-compatible LLM (optional) ----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Table suffixes (optional) ----
# Override these to run multiple pipeline versions side-by-side.
# MERGED_JOBS_TABLE=merged_jobs_3
# EXTRACTED_JOB_SKILLS_TABLE=extracted_job_skills_3
# NORMALIZED_JOB_SKILLS_TABLE=normalized_job_skills_3

# ---- JWT signing secret (API service) ----
# Generate a long random string in production, e.g.: `openssl rand -hex 32`
CAREERGO_JWT_SECRET=change-me-in-production

# ---- LLM reasoning switch (API service) ----
# Set to 0 to disable LLM enrichment during recommendations (falls back to the
# deterministic reasoning template). Default is 1 (enabled).
# RECOMMEND_USE_LLM=1

# ---- Sentence-Transformer model path (optional) ----
# Either a local directory or a HuggingFace Hub identifier.
# SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
